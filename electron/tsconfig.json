{
    "extends": ["../tsconfig.base.json"],
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": [
        "./**/*.ts",
        "./**/*.d.ts",
        "../types/vendor/utif.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
