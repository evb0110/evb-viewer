{
    "compilerOptions": {
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "useUnknownInCatchVariables": true,
        "strictBuiltinIteratorReturn": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "paths": {
            "#build": ["./.nuxt"],
            "#build/*": ["./.nuxt/*"],
            "@app/*": ["./app/*"],
            "@contracts/*": ["./packages/contracts/*"],
            "@node-runtime/*": ["./packages/node-runtime/*"],
            "@pdf-core": ["./packages/pdf-core/index.ts"],
            "@pdf-core/*": ["./packages/pdf-core/*"],
            "@electron-worker-bundles/*": ["./packages/electron-worker-bundles/*"],
            "@electron/*": ["./electron/*"],
            "@evb/scan-cleanup": ["./packages/scan-cleanup/index.ts"],
            "@evb/scan-cleanup/*": ["./packages/scan-cleanup/*"],
            "@root-package": ["./package.json"],
            "@i18n-core": ["./packages/i18n-core/index.ts"],
            "@i18n-core/*": ["./packages/i18n-core/*"],
            "@i18n-app": ["./packages/i18n-app/index.ts"],
            "@i18n-app/*": ["./packages/i18n-app/*"],
            "@releaseSelection": ["./packages/release-selection/index.ts"],
            "@releaseSelection/*": ["./packages/release-selection/*"],
            "@scripts/*": ["./scripts/*"],
            "@server/*": ["./server/*"],
            "@landing/*": ["./landing/*"],
            "@tests/*": ["./tests/*"]
        }
    }
}
