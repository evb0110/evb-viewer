{
  "name": "evb-viewer",
  "productName": "EVB Viewer",
  "version": "0.1.459",
  "author": "Eugene Barsky <34789976+evb0110@users.noreply.github.com>",
  "description": "EVB Viewer - a PDF and DjVu document viewer",
  "homepage": "https://github.com/evb0110/evb-viewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/evb0110/evb-viewer.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "pnpm run build:native && pnpm run build:electron && tsx scripts/electronRun.ts start",
    "dev": "node scripts/ensure-wasm-artifacts.mjs && tsx scripts/runDevWithOutputTee.ts",
    "dev:headless": "pnpm run electron:run:headless -- stop --session=default --keep-nuxt && pnpm run build:native && pnpm run build:electron && pnpm run electron:run:headless -- start",
    "dev:nuxt": "pnpm exec nuxi dev --host 127.0.0.1",
    "dev:web": "node scripts/ensure-wasm-artifacts.mjs && pnpm exec nuxi dev --host 127.0.0.1 --port 3235",
    "deploy:web": "node scripts/deployVercelPrivate.mjs",
    "deploy:web:prod": "node scripts/deployVercelPrivate.mjs --prod --logs",
    "deploy:landing": "node scripts/deployVercelPrivate.mjs --target=landing",
    "deploy:landing:prod": "node scripts/deployVercelPrivate.mjs --target=landing --prod --logs",
    "build": "node scripts/ensure-wasm-artifacts.mjs && pnpm run generate:build-artifacts && pnpm exec nuxi build && node scripts/upload-sentry-sourcemaps.mjs && node scripts/prune-build-artifacts.mjs && node scripts/check-web-deploy-assets.mjs",
    "build:desktop": "pnpm run build && pnpm run build:electron && pnpm run build:native",
    "build:strict": "node scripts/run-build-strict.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:native": "node scripts/build-native-tool.mjs --all",
    "build:native:e2e": "node scripts/build-native-tool.mjs pdf-image-combine pdf-page-ops pdf-search scan-cleanup",
    "build:pdf-image-combine": "node scripts/build-native-tool.mjs pdf-image-combine",
    "build:pdf-page-ops": "node scripts/build-native-tool.mjs pdf-page-ops",
    "build:pdf-search": "node scripts/build-native-tool.mjs pdf-search",
    "build:scan-cleanup": "node scripts/build-native-tool.mjs scan-cleanup",
    "scan-cleanup:convert": "node --import tsx scripts/scan-cleanup-convert.ts",
    "scan-cleanup:regress": "node scripts/scan-cleanup-regress.mjs",
    "generate:build-artifacts": "node --import tsx scripts/generateBuildArtifacts.ts",
    "preview": "pnpm exec nuxi preview",
    "postinstall": "pnpm exec nuxi prepare && pnpm run copy:pdfjs && pnpm run check:electron:install",
    "fetch:runtime-binaries": "node --import tsx scripts/fetchRuntimeBinaries.ts",
    "pack:runtime-binary-archives": "bash scripts/packRuntimeBinaryArchives.sh",
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs && node scripts/sync-pdfjs-viewer-css.mjs",
    "verify:pdfjs-provenance": "node scripts/verify-pdfjs-provenance.mjs",
    "typecheck": "node scripts/run-nuxt-typecheck.mjs && node scripts/run-workspace-package-typecheck.mjs --all",
    "typecheck:clean": "node scripts/run-nuxt-typecheck.mjs --cold && node scripts/run-workspace-package-typecheck.mjs --cold --all",
    "lint": "pnpm run check:architecture && stylelint 'app/**/*.{vue,scss,css}' --cache --cache-location .devkit/cache/stylelint && pnpm --dir landing run lint",
    "lint:clean": "eslint app electron packages scripts server tests eslint-plugin-custom.mjs vitest.config.ts vitest.shared.config.ts --no-cache --max-warnings=0 --report-unused-disable-directives && EVB_ESLINT_NAMING_ONLY=1 eslint landing --no-cache --max-warnings=0 --report-unused-disable-directives && pnpm exec depcruise --config .dependency-cruiser.cjs app electron landing packages scripts server && stylelint 'app/**/*.{vue,scss,css}' --no-cache && pnpm --dir landing run lint",
    "lint:fix": "eslint app electron packages scripts server tests eslint-plugin-custom.mjs vitest.config.ts vitest.shared.config.ts --fix --max-warnings=0 --report-unused-disable-directives && EVB_ESLINT_NAMING_ONLY=1 eslint landing --fix --max-warnings=0 --report-unused-disable-directives && pnpm exec depcruise --config .dependency-cruiser.cjs app electron landing packages scripts server && stylelint 'app/**/*.{vue,scss,css}' --fix && pnpm --dir landing run lint",
    "lint:all": "pnpm run lint",
    "fallow": "fallow dead-code",
    "fallow:all": "pnpm run fallow && pnpm run fallow:dupes",
    "fallow:dupes": "fallow dupes --production --threshold 0",
    "fallow:health:summary": "fallow health --summary || true",
    "test:coverage": "vitest run --coverage --project unit-core --project unit-app --project unit-electron --project unit-scripts --project unit-policy",
    "test:electron-bundle-static-integrity": "pnpm run build:electron && pnpm run test:electron-bundle-static-integrity:no-build && node scripts/prune-build-artifacts.mjs && pnpm run check:build-artifacts:hygiene",
    "test:electron-bundle-static-integrity:no-build": "vitest run --project electron-bundle-static-integrity",
    "test:unit": "node scripts/ensure-wasm-artifacts.mjs && vitest run --project unit-core --project unit-app --project unit-electron --project unit-scripts --project unit-policy",
    "test:integration:browser": "node scripts/ensure-wasm-artifacts.mjs && vitest run --project browser-integration",
    "lint:rust": "cargo fmt --manifest-path native/Cargo.toml --all --check && cargo clippy --manifest-path native/Cargo.toml --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path native/Cargo.toml --workspace --locked",
    "test:scan-cleanup:affected-oracles": "scripts/ci/scan-cleanup-oracles.sh affected",
    "test:scan-cleanup:canonical-identity": "cargo test --release --locked --manifest-path native/Cargo.toml -p evb-scan-cleanup --bin scan-cleanup-harness tests::tracked_corpus_routes_reconciliation_and_leaf_resolution_are_dpi_identical -- --ignored --exact",
    "test:e2e": "pnpm run build && pnpm run build:native:e2e && pnpm run build:electron && bash scripts/test-electron-e2e-headless.sh --no-build",
    "test:e2e:visible-window": "pnpm run build && pnpm run build:native:e2e && pnpm run build:electron && vitest run --project e2e-visible-window --reporter verbose",
    "test:packaged-core-pdf-smoke": "pnpm exec tsx scripts/release/verifyPackagedCorePdfSmoke.ts",
    "electron:run": "node --import tsx scripts/electronRun.ts",
    "worktrees:prune": "node scripts/worktrees-prune.mjs",
    "electron:run:headless": "bash scripts/electron-run-headless.sh",
    "diag:pdf-navigation-blink-trace": "pnpm run build:electron && pnpm exec tsx scripts/diagnostics/pdfNavigationBlinkTrace.ts",
    "test:ocr:quality:required": "EVB_OCR_QUALITY_REQUIRED=1 node scripts/test-ocr-quality-corpus.mjs",
    "diag:pdf-skeleton-navigation": "pnpm run build:electron && pnpm exec tsx scripts/diagnostics/runPdfSkeletonNavigationDiagnostics.ts",
    "diag:pdf-facing-continuous": "pnpm run build:electron && pnpm exec tsx scripts/diagnostics/pdfFacingContinuousRegression.ts",
    "diag:pdf-tabs": "pnpm exec tsx scripts/diagnostics/pdfTabPressure.ts",
    "diag:arnold-pdf-open": "pnpm run build:electron && pnpm exec tsx scripts/diagnostics/runArnoldPdfOpenDiagnostics.ts",
    "diag:scan-cleanup-corpus-verify": "node scripts/diagnostics/scan-cleanup-corpus-verify.mjs",
    "diag:scan-cleanup-preview-harness": "node scripts/diagnostics/scan-cleanup-preview-harness.mjs",
    "diag:scan-cleanup-representative-audit": "node scripts/diagnostics/scan-cleanup-representative-audit.mjs",
    "diag:scan-cleanup-rendered-metrics": "python3 scripts/diagnostics/scan-cleanup-rendered-metrics.py",
    "diag:verify-generated-pdf": "python3 scripts/diagnostics/verify-generated-pdf.py",
    "diag:pdf-tabs:ci": "sh -c 'pnpm electron:run stop --session=pdf-tabs-ci >/dev/null 2>&1 || true; pnpm run build:electron && pnpm electron:run startd --session=pdf-tabs-ci && pnpm diag:pdf-tabs --session pdf-tabs-ci --tabs 4 --cycles 3 --gc --sample-heap --max-inactive-canvases 0 --max-inactive-rendered-pages 0 --max-inactive-djvu-images 0 --max-inactive-canvas-pixels 0; status=$?; pnpm electron:run stop --session=pdf-tabs-ci >/dev/null 2>&1 || true; exit $status'",
    "benchmark:save-pipeline": "node scripts/benchmark-save-pipeline.mjs",
    "dist": "node scripts/check-dev-environment.mjs --strict && pnpm run build:desktop && electron-builder",
    "release:verify:checks": "node scripts/release/verify-local-checks.mjs",
    "release:verify:package:local": "node scripts/release/verify-local-package.mjs",
    "release:verify": "node scripts/release/verify-local.mjs",
    "release:cut": "HUSKY=0 node scripts/release/cut-release.mjs",
    "release:status": "node scripts/release/release-status.mjs",
    "check:dev-env": "node scripts/check-dev-environment.mjs",
    "check:electron:install": "node scripts/check-electron-install.mjs",
    "check:electron-builder:asar-unpack": "node scripts/check-electron-builder-asar-unpack.mjs",
    "check:production-dependency-audit": "pnpm exec tsx scripts/checkProductionDependencyAudit.ts",
    "check:production-dependency-audit:production-only": "pnpm exec tsx scripts/checkProductionDependencyAudit.ts --production-only",
    "check:static:assets": "node scripts/check-web-deploy-source.mjs",
    "check:build-artifacts:hygiene": "node scripts/check-build-artifacts-hygiene.mjs",
    "check:architecture": "eslint app electron packages scripts server tests eslint-plugin-custom.mjs vitest.config.ts vitest.shared.config.ts --cache --cache-location .devkit/cache/eslint --max-warnings=0 --report-unused-disable-directives && EVB_ESLINT_NAMING_ONLY=1 eslint landing --cache --cache-location .devkit/cache/eslint --max-warnings=0 --report-unused-disable-directives && pnpm exec depcruise --config .dependency-cruiser.cjs app electron landing packages scripts server",
    "preversion": "pnpm run fetch:runtime-binaries",
    "prepare": "pnpm run fetch:runtime-binaries --if-published && pnpm run generate:build-artifacts && husky"
  },
  "lint-staged": {
    "!(*.config).{ts,mts,mjs,vue}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "app/**/*.{vue,scss,css}": "stylelint --fix"
  },
