+#elif NOTHREADS
+
+// ----------------------------------------
+// SINGLE-THREADED EMSCRIPTEN IMPLEMENTATION
+// ----------------------------------------
+
+GThread::GThread(int) : xentry(0), xarg(0) {}
+
+GThread::~GThread() {}
+
+int
+GThread::create(void (*entry)(void*), void *arg)
+{
+  if (xentry || xarg)
+    return -1;
+  xentry = entry;
+  xarg = arg;
+  if (entry)
+    entry(arg);
+  return 1;
+}
+
+void
+GThread::terminate() {}
+
+int
+GThread::yield()
+{
+  return 0;
+}
+
+void *
+GThread::current()
+{
+  return (void*)1;
+}
+
+GMonitor::GMonitor() : count(1) {}
+
+GMonitor::~GMonitor() {}
+
+void
+GMonitor::enter()
+{
+  count -= 1;
+}
+
+void
+GMonitor::leave()
+{
+  count += 1;
+}
+
+void
+GMonitor::signal() {}
+
+void
+GMonitor::broadcast() {}
+
+void
+GMonitor::wait()
+{
+  G_THROW( ERR_MSG("GThreads.co_wait") );
+}
+
+void
+GMonitor::wait(unsigned long)
+{
+  G_THROW( ERR_MSG("GThreads.co_wait") );
+}
+
 #endif
 
 
