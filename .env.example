# Root EVB Viewer app optional runtime configuration.
NUXT_PUBLIC_SITE_URL=http://localhost:3235
NUXT_PUBLIC_LANDING_URL=http://localhost:3000
# Vercel Web Analytics for the hosted browser build.
NUXT_PUBLIC_ANALYTICS_ENABLED=0

# Optional manual Electron diagnostics. These PDFs stay local and are ignored by git.
EVB_DIAGNOSTIC_PDF_PATH=
EVB_E2E_ARNOLD_PDF_PATH=
EVB_E2E_NAVIGATION_PDF_PATH=
EVB_E2E_PAGE_JUMP_PDF_PATH=
