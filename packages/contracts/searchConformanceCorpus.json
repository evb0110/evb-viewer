  "geometryCase": {
    "id": "ocr-geometry-utf16-range",
    "description": "Geometry attachment crops OCR word boxes using the same UTF-16 offsets as text matches.",
    "pageWidth": 200,
    "pageHeight": 100,
    "words": [
      {
        "text": "alpha",
        "x": 0,
        "y": 10,
        "width": 50,
        "height": 10
      },
      {
        "text": "needle",
        "x": 60,
        "y": 10,
        "width": 60,
        "height": 10
      }
    ],
    "text": "alpha needle \n",
    "query": "eed",
    "range": {
      "startOffset": 7,
      "endOffset": 10
    },
    "expectedWords": [
      {
        "text": "eed",
        "x": 70,
        "y": 10,
        "width": 30,
        "height": 10
      }
    ]
  }
