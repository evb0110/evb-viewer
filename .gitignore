# Local-only artifacts: agent-harness instruction files and configuration, plus
# the .devkit/ working material. scripts/lib/local-artifact-policy.mjs is the
# canonical list, and these entries mirror it literally.
#
# These are developer convenience only: Git matches them case-sensitively, so a
# stray `Claude.Md` is not ignored here. The pre-commit and pre-push checks are
# the deterministic gate and reject every case variant at any depth.
**/AGENTS.md
!/AGENTS.md
**/CLAUDE.md
!/CLAUDE.md
GEMINI.md
.agents/
.claude/
.codex/
.devkit/
**/HANDOFF.md
**/NOTES.md
**/TODO.md
!docs/**/HANDOFF.md
!docs/**/NOTES.md
!docs/**/TODO.md

# A local scratch note some contributors keep. Not part of the canonical
# local-only artifact policy: it is ignored as a convenience, and nothing rejects
# it from history if someone deliberately tracks one.
MEMORIES.md

# Local env files
.env
.env.*
!.env.example

.DS_Store
.vercel
.playwright-cli/
.playwright-mcp/
after-*.yml
.tmp/
tmp/
temp/
.temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
*.log
.eslintcache
playwright-report/
test-results/
auto-imports.d.ts

# Large/manual regression fixtures live in the repo checkout but are opt-in and
# intentionally excluded from git, Electron packages, and web deploys.
tests/fixtures/electron/large-pdf-fixtures/*
!tests/fixtures/electron/large-pdf-fixtures/README.md

# Local scratch output and package-manager cache. `.env*` is not repeated here:
# a second, broader env pattern after `!.env.example` would re-ignore the tracked
# example file.
/output/
.pnpm-store/

# Electron-builder creates one directory per Windows Store target before it
# writes the final AppX package into release/.
/store-appx-win-x64/
/store-appx-win-arm64/
