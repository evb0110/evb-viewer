{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evb-viewer.dev/schemas/electron-e2e-quarantine-graduation-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "lane",
    "operatorDiagnostics",
    "tests"
  ],
  "properties": {
    "$schema": {
      "const": "./graduation-policy.schema.json"
    },
    "version": {
      "const": 4
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "blocking",
        "infraRetryCount"
      ],
      "properties": {
        "events": {
          "const": [
            "workflow_dispatch"
          ]
        },
        "blocking": {
          "const": false
        },
        "infraRetryCount": {
          "const": 2
        }
      }
    },
    "operatorDiagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^tests/e2e/electron/quarantine/.+\\.e2e\\.test\\.ts$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertionReport",
          "expiresOn",
          "issue",
          "path",
          "targetProject"
        ],
        "properties": {
          "assertionReport": {
            "type": "string",
            "pattern": "^tests/e2e/electron/quarantine/.+\\.e2e\\.test\\.ts$"
          },
          "expiresOn": {
            "type": "string",
            "format": "date"
          },
          "issue": {
            "type": "string",
            "pattern": "^(#\\d+|https://github\\.com/evb0110/evb-viewer/issues/\\d+)$"
          },
          "path": {
            "type": "string",
            "pattern": "^tests/e2e/electron/quarantine/.+\\.e2e\\.test\\.ts$"
          },
          "targetProject": {
            "enum": [
              "e2e-regression",
              "e2e-blocking-smoke"
            ]
          }
        }
      }
    }
  }
}
