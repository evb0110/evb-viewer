# Husky runs this with `sh -e`, so it must stay POSIX: no bashisms.
refs_file="$(mktemp "${TMPDIR:-/tmp}/evb-pre-push.XXXXXX")"
trap 'rm -f "$refs_file"' EXIT
cat >"$refs_file"

node scripts/check-publication-policy.mjs --pre-push "$1" "${2-}" <"$refs_file"

if [ "${EVB_SKIP_PRE_PUSH_VERIFICATION:-}" = "1" ]; then
    echo '[pre-push] Typecheck skipped via EVB_SKIP_PRE_PUSH_VERIFICATION=1.' >&2
    exit 0
fi

typecheck_needed=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    case "$remote_sha" in
        0000000000000000000000000000000000000000)
            base_sha="$(git rev-list --max-parents=0 "$local_sha" | tail -n 1)"
            ;;
        *) base_sha="$remote_sha" ;;
    esac
    if git diff --name-only "$base_sha" "$local_sha" | grep -E '\.(ts|tsx|mts|cts|vue)$' >/dev/null; then
        typecheck_needed=1
    fi
done <"$refs_file"

if [ "$typecheck_needed" = "1" ]; then
    pnpm typecheck
fi
